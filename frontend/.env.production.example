# ============================================
# HATLY FRONTEND - PRODUCTION ENV (Railway)
# ============================================
# Copy this to .env and fill in real values

# Backend API URL (replace with your Railway backend URL)
VITE_API_URL=https://hatly-backend.up.railway.app/api/v1

# WebSocket URL (same host as backend, no /api path)
VITE_SOCKET_URL=https://hatly-backend.up.railway.app

# App settings
VITE_DEFAULT_COUNTRY=Egypt
VITE_DEFAULT_CURRENCY=EGP
VITE_DEFAULT_LANGUAGE=ar

# Optional: Google Maps API key (leave blank to use OpenStreetMap)
VITE_GOOGLE_MAPS_KEY=
