# ============================================
# HATLY PROJECT - .gitignore
# ============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds
frontend/dist/
frontend/build/
backend/dist/

# Environment files - NEVER commit these
.env
.env.local
.env.development
.env.production
.env.*.local
backend/.env
frontend/.env
frontend/.env.*

# Keep example files
!backend/.env.example
!backend/.env.production.example
!frontend/.env.production.example

# Database files - SQLite (sensitive data)
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-shm
backend/prisma/*.db-wal
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/
backend/logs/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# TypeScript cache
*.tsbuildinfo

# Prisma
backend/prisma/generated/

# npm temp
e:/npm-temp/
npm-temp/

# Uploaded files / user media
backend/uploads/
backend/public/uploads/

# Test coverage
coverage/
.nyc_output/

# Backup folders
backup_checkpoint/
backup_checkpoint_v2/
