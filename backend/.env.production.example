# ========================================================
# HATLY BACKEND - PRODUCTION ENV (Railway)
# ========================================================

PORT=5000
NODE_ENV=production

# IMPORTANT: Replace with a strong random 64+ char secret
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_64CHARS_MIN
JWT_EXPIRES_IN=7d

# CORS: Replace with your Vercel frontend URL after deployment
CORS_ORIGIN=https://hatly-frontend.vercel.app

# Database: Railway PostgreSQL URL (set automatically by Railway)
# DATABASE_URL=postgresql://user:pass@host:port/db

# Default to SQLite (Railway persistent disk) if PostgreSQL not configured
DATABASE_URL=file:./prod.db

# Map defaults for Alexandria, Egypt
DEFAULT_CITY=Alexandria
DEFAULT_LAT=31.2001
DEFAULT_LNG=29.9187

# SMS OTP (sandbox mode - real OTP code is 1234)
SMS_PROVIDER=SANDBOX
OTP_EXPIRY_MINUTES=5
MOCK_OTP_CODE=1234

# Payment Gateway (sandbox)
PAYMENT_GATEWAY_PROVIDER=SANDBOX
