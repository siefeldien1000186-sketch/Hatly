PORT=5000
NODE_ENV=development

# For SQLite (Local zero-config dev):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hatly_db?schema=public"

JWT_SECRET="your_strong_jwt_secret_here"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Geolocation Defaults (Cairo, Egypt)
DEFAULT_CITY="Cairo"
DEFAULT_LAT=30.0444
DEFAULT_LNG=31.2357

# Egyptian Payment Gateways (Paymob, Fawry, Kashier, Instapay)
PAYMENT_GATEWAY_PROVIDER="SANDBOX" # SANDBOX | PAYMOB | FAWRY | KASHIER
PAYMENT_API_KEY=""
PAYMENT_MERCHANT_ID=""

# Egyptian SMS OTP Providers (VictoryLink, Infobip, Twilio)
SMS_PROVIDER="SANDBOX" # SANDBOX | VICTORYLINK | INFOBIP | TWILIO
SMS_API_KEY=""
SMS_SENDER_NAME="Hatly"
OTP_EXPIRY_MINUTES=5
MOCK_OTP_CODE="1234"
